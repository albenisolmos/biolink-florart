---
import Card from '../components/Card.astro'
import ButtonLink from '../components/ButtonLink.astro'
import Layout from '../layouts/Layout.astro'
import Logo from '../icons/Logo.astro'
import Header from '../components/Header.astro'
import TelegramIcon from '../icons/Telegram.astro'
import WhatsappIcon from '../icons/Whatsapp.astro'

const linkToWhatsapp = 'https://wa.me/message/4BEU6RWR36OYM1'
const linkToTelegram = 'https://t.me/Florart10'
---
<Layout
	title='Florart - Descubre de la eternidad en nuestras flores'
	description='Bio link de flor art'>
	<main class='flex flex-col items-center gap-2 h-full w-full'>
		<Header/>

		<section class='relative flex-1 w-full max-w-[40em] flex flex-col items-center justify-center gap-4 px-2'>
			<Logo class='absolute text-white/10 size-96 lg:size-[40em] left-[50%] top-[50%] translate-x-[-50%] translate-y-[-50%] -z-10'/>

			<ButtonLink href={linkToWhatsapp}>
				<WhatsappIcon class='size-8'/>
				Whatsapp
			</ButtonLink>
			<ButtonLink href={linkToTelegram}>
				<TelegramIcon class='size-8'/>
				Telegram
			</ButtonLink>
		</section>

		<span class="pt-9 text-xl text-[zain] text-center italic text-white">Desde una flor única hasta un conjunto armonioso</span>
		<section class="grid grid-cols-1 lg:grid-cols-2 gap-4 w-full min-w-[500px] max-w-[40em] ">
			<Card title="Ramo de tulipanes" img="/tulipanes.webp"/>
			<Card title="Ramos Rosas" img="/flor-3.webp"/>
			<Card title="Ramos Buchones" img="/ramo-buchon.webp"/>
			<Card title="Ramos Margarita" img="/margaritas.webp"/>
			<Card title="Cajas de Regalos" img="/caja.webp"/>
			<Card title="Lapiceros Personalizados" img="/lapiceros.webp"/>
			<Card title="Alpitas Personalizados" img="/alpitas.webp"/>
			<Card title="Arreglos" img="/arreglo.webp"/>
		</section>
	</main>
</Layout>
